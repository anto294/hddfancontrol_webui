[Unit]
Description=hddfancontrol web UI (fan control from drive temperatures, hd-idle)
Documentation=https://github.com/anto294/hddfancontrol_webui
After=local-fs.target systemd-modules-load.service

[Service]
Type=simple
Environment=CONFIG_DIR=/var/lib/hddfancontrol-webui
# The static hddfancontrol, hd-idle and sdparm of the release come first.
Environment=PATH=/opt/hddfancontrol-webui/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# sensors-detect --auto can change /etc/modules on a real host: off by default.
Environment=LOAD_SENSOR_MODULES=false
# Values in this file win over the ones above.
EnvironmentFile=-/etc/hddfancontrol-webui/env
ExecStart=/opt/hddfancontrol-webui/venv/bin/hddfancontrol-webui
StateDirectory=hddfancontrol-webui
# 0711: the gateway's user may reach its own folder (web/), nothing else.
StateDirectoryMode=0711
# SIGTERM goes to the web UI, which gives the fans back first, then stops
# the gateway and the daemons (up to 15 s each).
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

# Root is needed for /sys PWM files and drive commands; keep the rest closed.
# The web server itself runs as the hddfancontrol-webui user (the gateway).
NoNewPrivileges=true
# What root needs here, and nothing more: drive commands (smartctl, hdparm,
# hd-idle: SYS_RAWIO, SYS_ADMIN), the gateway's user and folder (SETUID,
# SETGID, CHOWN, FOWNER), stopping it (KILL), reading TLS_CERT/TLS_KEY and
# /sys whatever their owner (DAC_OVERRIDE), and modprobe for the sensor
# scan (SYS_MODULE; off unless LOAD_SENSOR_MODULES=true).
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_KILL CAP_SYS_MODULE
ProtectKernelLogs=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
ProtectHostname=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=192M

[Install]
WantedBy=multi-user.target
