# /etc/hddfancontrol-webui/env: read by hddfancontrol-webui.service.
# Restart the service after a change: systemctl restart hddfancontrol-webui

# Port and address of the web UI.
WEBUI_PORT=8080
WEBUI_HOST=0.0.0.0

# Protect the web UI. You can also set the credentials in the web UI
# (Security); these variables win over it.
#WEBUI_USERNAME=admin
#WEBUI_PASSWORD=

# Run sensors-detect --auto at start and load the chip modules it finds.
# Off by default on bare metal: prefer loading the module once with
# "sudo sensors-detect" and /etc/modules.
#LOAD_SENSOR_MODULES=false

# Everything else (drives, fans, temperatures, spin down) is set in the web
# UI. The variables of the Docker image work here too, for example:
#DRIVES=/dev/disk/by-id/ata-ST4000VN006-3CW104_ZW627CWW
#MONITOR_DRIVES=/dev/disk/by-id/ata-ST4000VN006-3CW104_ZW627CWW
#PWM=/sys/class/hwmon/hwmon3/pwm1:200:75
